# App/brand name shown across the UI (Header, Footer, page titles, RSS, etc.).
APP_NAME=hanasalabs.id

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Address that contact messages are sent to.
CONTACT_TO_EMAIL=hello@hanasalabs.id

# Sender address. Use a verified hanasalabs.id address once the domain is
# verified in Resend; otherwise Resend's test sender works for development.
FROM_ADDRESS=onboarding@resend.dev
