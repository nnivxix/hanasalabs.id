---
import type { CollectionEntry } from 'astro:content';
import { formatDateLong, readingTime } from '../lib/utils';

interface Props {
  post: CollectionEntry<'blog'>;
  rawBody?: string;
}

const { post, rawBody } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = rawBody ? readingTime(rawBody) : null;
---

<article class="prose prose-lg max-w-none dark:prose-invert">
  <header class="not-prose mb-10 border-b border-border pb-6">
    <h1 class="mb-2 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
      {title}
    </h1>
    {description && (
      <p class="text-lg text-muted-foreground">{description}</p>
    )}
    <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
      <time datetime={pubDate.toISOString()}>{formatDateLong(pubDate)}</time>
      {updatedDate && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>Updated {formatDateLong(updatedDate)}</span>
        </>
      )}
      {minutes && (
        <>
          <span aria-hidden="true">&middot;</span>
          <span>{minutes} min read</span>
        </>
      )}
    </div>
    {tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li class="rounded-full bg-secondary px-2 py-0.5 text-xs text-secondary-foreground">
            #{tag}
          </li>
        ))}
      </ul>
    )}
  </header>

  <slot />
</article>
