---
import { cn } from '../lib/utils';

interface Props {
  type?: 'info' | 'warning' | 'success';
  class?: string;
}

const { type = 'info', class: className } = Astro.props;

const styles = {
  info: 'border-blue-500 bg-blue-50 text-blue-900 dark:border-blue-400 dark:bg-blue-950/40 dark:text-blue-200',
  warning:
    'border-amber-500 bg-amber-50 text-amber-900 dark:border-amber-400 dark:bg-amber-950/40 dark:text-amber-200',
  success:
    'border-emerald-500 bg-emerald-50 text-emerald-900 dark:border-emerald-400 dark:bg-emerald-950/40 dark:text-emerald-200',
} as const;
---

<aside
  class={cn('border-l-4 p-4 my-6 rounded-r-md text-sm leading-relaxed', styles[type], className)}
>
  <slot />
</aside>
