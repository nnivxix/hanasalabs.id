---
import { APP_NAME } from '../lib/site';
---

<section
  class="flex flex-1 flex-col items-center justify-center px-6 py-24 text-center sm:py-32"
>
  <div class="flex max-w-2xl flex-col gap-6">
    <h1 class="text-4xl font-bold tracking-tight text-foreground sm:text-5xl md:text-6xl">
      Welcome to {APP_NAME}
    </h1>
    <p class="text-lg leading-relaxed text-muted-foreground">
      A space where ideas grow into experiments, and experiments grow into building
      blocks for what&rsquo;s next.
    </p>
  </div>
</section>
